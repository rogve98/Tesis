\contentsline {figure}{\numberline {2.1}{\ignorespaces Campo vectorial de las soluciones del sistema (\ref {eqn:Sist2x2Comp}) de dos especies.}}{8}{figure.caption.14}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Sistema de Lotka--Volterra con interacciones de mutualismo dados por las ecuaciones (\ref {eqn:Sist2x2Coop}). Tasas de crecimiento y capacidades de carga: $r_x=2$, $K_x=2$ y $r_y=3$, $K_y=3$. (\textbf {A}) Series de tiempo del sistema para las especies $x(t)$ y $y(t)$ bajo la condición inicial $(1,2)$. (\textbf {B}) Espacio fase del sistema con sus puntos fijos asociados, donde $(7,10)$ es el único punto fijo estable.}}{11}{figure.caption.16}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Series de tiempo para las interacciones comensalismo, amensalismo y depredación modificando el sistema \eqref {eqn:Sist2x2Coop}. (\textbf {A}) Para el comensalismo se definió $\alpha _{21}=0$ y $\alpha _{12}=-\frac {1}{2}$. (\textbf {B}) Para el amensalismo se consideró $\alpha _{21}=0$ y $\alpha _{12}=\frac {1}{2}$ (\textbf {C}) Para la depredación se consideró $\alpha _{21}=-1$ y $\alpha _{12}=\frac {1}{2}$.}}{12}{figure.caption.17}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces Distribución de valores propios en sistemas de May con soporte simétrico y puramente aleatorios. En ambos ejemplos se consideró $N=100$, magnitud típica $\sigma =0.2$, para una conectividad $C=\frac {1}{\sigma ^2 N}-0.03$ y $d=-1$.}}{15}{figure.caption.18}%
\contentsline {figure}{\numberline {2.5}{\ignorespaces Distribución de valores propios en sistemas de May con soporte simétrico y puramente aleatorios. En ambos ejemplos se consideró $N=100$, magnitud típica $\sigma =0.4$, para una conectividad $C=\frac {1}{\sigma ^2 N}-0.03$ y $d=-1$. La distribución mostrada en (\textbf {A}) presenta una visible deformación debido al soporte simétrico de su matriz de interacciones asociada, por lo que la ley circular y el radio espectral no son suficientes para ajustar dicha distribución.}}{16}{figure.caption.19}%
\contentsline {figure}{\numberline {2.6}{\ignorespaces Transición dinámica en sistemas de May aleatorios en función de la conectividad $C$. Para cada configuración se generaron 3000 simulaciones independientes.}}{16}{figure.caption.20}%
\contentsline {figure}{\numberline {2.7}{\ignorespaces Transición dinámica en sistemas de May aleatorios en función de la conectividad $C$ en escala $\log _{10}$.}}{17}{figure.caption.21}%
\contentsline {figure}{\numberline {2.8}{\ignorespaces Transición de May puramente aleatoria vs estructuralmente simétrica. (\textbf {A}) Se considera para $\sigma = 0.2$ (\textbf {B}) Se considera para $\sigma =0.6$.}}{18}{figure.caption.22}%
\contentsline {figure}{\numberline {2.9}{\ignorespaces Transición dinámica en función de $\sigma $ (\textbf {A}) Se consideran sistemas de May aleatorios con 3000 simulaciones por cada configuración. (\textbf {B}) Caso particular para $C=0.1$; se consideran las diferencias entre sistemas de soporte simétrico y puramente aleatorios.}}{18}{figure.caption.23}%
\contentsline {figure}{\numberline {2.10}{\ignorespaces Variación de la transición entre sistemas estructuralmente simétricas y puramente aleatorios. Se considera el valor de la conectividad $C=0.6$.}}{19}{figure.caption.24}%
\contentsline {figure}{\numberline {2.11}{\ignorespaces Re--escalamiento del eje $x$ al radio espectral $\sigma \sqrt {NC}$. Las variaciones en $C$ y $\sigma $ fueron las mismas que en los casos anteriores considerados. Para este caso particular se ha fijado $\sigma =C=0.2$.}}{21}{figure.caption.25}%
\contentsline {figure}{\numberline {2.12}{\ignorespaces Re--escalamiento del eje $x$ al radio espectral $\sigma \sqrt {NC}$. Las variaciones en $C$ y $\sigma $ fueron las mismas que en los casos anteriores considerados. Para este caso particular se ha fijado $\sigma =C=0.6$.}}{21}{figure.caption.26}%
