\@writefile{lof}{\contentsline {figure}{\numberline {2.4}{\ignorespaces Distribución de valores propios en sistemas de May con soporte simétrico y puramente aleatorios. En ambos ejemplos se consideró $N=100$, magnitud típica $\sigma =0.2$, para una conectividad $C=\frac  {1}{\sigma ^2 N}-0.03$ y $d=-1$.}}{15}{figure.caption.18}\protected@file@percent }
\newlabel{fig:LeyCircularMay}{{2.4}{15}{Distribución de valores propios en sistemas de May con soporte simétrico y puramente aleatorios. En ambos ejemplos se consideró $N=100$, magnitud típica $\sigma =0.2$, para una conectividad $C=\frac {1}{\sigma ^2 N}-0.03$ y $d=-1$}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.5}{\ignorespaces Distribución de valores propios en sistemas de May con soporte simétrico y puramente aleatorios. En ambos ejemplos se consideró $N=100$, magnitud típica $\sigma =0.4$, para una conectividad $C=\frac  {1}{\sigma ^2 N}-0.03$ y $d=-1$. La distribución mostrada en (\textbf  {A}) presenta una visible deformación debido al soporte simétrico de su matriz de interacciones asociada, por lo que la ley circular y el radio espectral no son suficientes para ajustar dicha distribución.}}{16}{figure.caption.19}\protected@file@percent }
\newlabel{fig:LeyCircularMay2}{{2.5}{16}{Distribución de valores propios en sistemas de May con soporte simétrico y puramente aleatorios. En ambos ejemplos se consideró $N=100$, magnitud típica $\sigma =0.4$, para una conectividad $C=\frac {1}{\sigma ^2 N}-0.03$ y $d=-1$. La distribución mostrada en (\textbf {A}) presenta una visible deformación debido al soporte simétrico de su matriz de interacciones asociada, por lo que la ley circular y el radio espectral no son suficientes para ajustar dicha distribución}{figure.caption.19}{}}
